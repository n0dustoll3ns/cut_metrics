// .devcontainer/devcontainer.json
{
  "name": "flutter-android-dev",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu-24.04",
  "features": {
    "ghcr.io/devcontainers/features/java:1": {
      "version": "17",
      "installGradle": false
    }
  },
  "containerEnv": {
    "ANDROID_HOME": "/workspaces/android-sdk",
    "FLUTTER_ROOT": "/workspaces/flutter",
    "GRADLE_USER_HOME": "/workspaces/.gradle",
    "PUB_CACHE": "/workspaces/.pub-cache"
  },
  "remoteEnv": {
    "PATH": "/workspaces/flutter/bin:/workspaces/android-sdk/cmdline-tools/latest/bin:/workspaces/android-sdk/platform-tools:${containerEnv:PATH}"
  },
  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "customizations": {
    "vscode": {
      "extensions": [
        "Dart-Code.dart-code",
        "Dart-Code.flutter",
        "saoudrizwan.claude-dev"
      ]
    },
    "settings": {
      "dart.flutterSdkPath": "/workspaces/flutter"
    }
  }
}